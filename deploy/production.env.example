# Copy to .env.production in the repository root; chmod 600 .env.production.
# Generate a URL-safe database password with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-generated-hex-password
APP_VERSION=local
APP_PORT=3000

# For SSH tunnel verification. Change to https://your-domain before public launch.
AUTH_URL=http://localhost:3310
AUTH_SECRET=replace-with-output-of-openssl-rand-hex-32
AUTH_TRUST_HOST=true
MEDIA_STORAGE=cos
MEDIA_CACHE_MAX_MB=512
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# Required only when enabling the public Caddy profile.
APP_DOMAIN=
ACME_EMAIL=

# Only set after public security filing approval. All three values are required to display it.
PUBLIC_SECURITY_RECORD_NUMBER=
PUBLIC_SECURITY_RECORD_URL=
PUBLIC_SECURITY_RECORD_ICON=

# Optional AI features: copy the production values if currently used.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
IMPORT_VISION_LABEL=
IMPORT_VISION_BASE_URL=
IMPORT_VISION_API_KEY=
IMPORT_VISION_MODEL=
TAG_RECOGNITION_BASE_URL=
TAG_RECOGNITION_API_KEY=
TAG_RECOGNITION_MODEL=

# DIY product cards: text model; credentials/base URL fall back to DEEPSEEK_*.
PRODUCT_CARD_API_KEY=
PRODUCT_CARD_BASE_URL=
PRODUCT_CARD_MODEL=deepseek-flash
