# SERVER ONLY: copy as .env.development-db.local, chmod 600.
DEV_POSTGRES_PASSWORD=replace-with-output-of-openssl-rand-hex-32

# LOCAL COMPUTER: add the following to .env (not to Git).
# DATABASE_URL=postgresql://crystal_dev:SERVER_DEV_PASSWORD@127.0.0.1:15432/crystal_mate_dev?schema=public&connection_limit=5
# DIRECT_URL=postgresql://crystal_dev:SERVER_DEV_PASSWORD@127.0.0.1:15432/crystal_mate_dev?schema=public
# DEV_DATABASE_SSH_HOST=your-server-ip
# DEV_DATABASE_SSH_USER=ubuntu
# DEV_DATABASE_SSH_IDENTITY_FILE=~/.ssh/crystal_mate_deploy_ed25519
# DEV_DATABASE_SSH_KNOWN_HOSTS_FILE=~/.ssh/known_hosts_crystal_mate
