generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id              String              @id @default(cuid())
  username        String              @unique
  passwordHash    String
  nickname        String              @default("")
  avatarObjectKey String?
  avatarUrl       String?
  recentMaterials DiyRecentMaterial[]
  recentCabochons DiyRecentCabochon[]
  sessionVersion  Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model EditorDraft {
  ownerId   String?
  id        String   @id @default(cuid())
  kind      String
  title     String   @default("")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, updatedAt(sort: Desc)])
  @@index([ownerId, kind, updatedAt(sort: Desc)])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  prefix    String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  products  ProductTag[]
  materials MaterialTag[]
}

model DistributorArea {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Distributor {
  id                     String                  @id @default(cuid())
  name                   String
  area                   String
  address                String                  @default("")
  wechat                 String                  @default("")
  phone                  String                  @default("")
  notes                  String                  @default("") @db.Text
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  materialBatchEntries   MaterialBatchEntry[]
  productPurchaseEntries ProductPurchaseEntry[]
  coverObjectKey         String?
  attachmentsVersion     Int                     @default(0)
  attachments            DistributorAttachment[]

  @@index([area])
  @@index([createdAt])
}

model DistributorAttachment {
  assetId       String
  asset         SharedAttachment @relation(fields: [assetId], references: [id], onDelete: Cascade)
  id            String           @id @default(cuid())
  distributorId String
  distributor   Distributor      @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  objectKey     String
  url           String
  fileName      String
  notes         String           @default("") @db.Text
  position      Int
  createdAt     DateTime         @default(now())

  @@unique([distributorId, assetId])
  @@unique([distributorId, position])
  @@unique([distributorId, objectKey])
}

model Product {
  id               String                   @id @default(cuid())
  code             String                   @unique
  name             String
  aliases          String[]                 @default([])
  description      String                   @default("") @db.Text
  categoryId       String
  category         Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceCents       Int
  saleRule         ProductSaleRule          @default(PERCENT_50)
  saleRuleValue    Decimal?                 @db.Decimal(12, 2)
  saleManual       Boolean                  @default(true)
  currency         String                   @default("CNY")
  stock            Int                      @default(1)
  origin           ProductOrigin?
  published        Boolean                  @default(false)
  images           ProductImage[]
  tags             ProductTag[]
  marketing        ProductMarketing?
  measurement      CabochonMeasurement?
  cost             CabochonCost?
  extraInfo        CabochonExtraInfo?
  purchaseEntries  ProductPurchaseEntry[]
  diyImageImports  DiyImageImport[]
  diyRuns          ProductDiyRun[]
  cards            ProductCard[]
  cardAssets       ProductCardAsset[]
  recentDiyUses    DiyRecentCabochon[]
  diyInputs        ProductDiyCabochon[]     @relation("DiyCabochonInput")
  stockAdjustments ProductStockAdjustment[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([categoryId])
  @@index([published, stock])
  @@index([createdAt])
}

/// Permanent code history, including reservations. Kept when a product or category is deleted.
model ProductCode {
  code             String   @id
  prefix           String?
  sequence         Int?
  categoryId       String
  productId        String?
  reservationToken String?  @unique
  createdAt        DateTime @default(now())

  @@index([prefix, sequence(sort: Desc)])
}

/// Reviewed spreadsheet drafts and durable per-row receipts for historical cabochons.
model CabochonExcelImport {
  id        String   @id @db.Uuid
  fileHash  String
  fileName  String
  sheetName String
  rows      Json
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileHash, sheetName])
  @@index([updatedAt])
}

/// Reviewed silver procurement drafts; receipts and purchases commit atomically per source row.
model MaterialPricingImport {
  id        String   @id @db.Uuid
  fileHash  String
  fileName  String
  sheetName String
  rows      Json
  execution Json?
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fileHash, sheetName])
  @@index([updatedAt])
}

enum ProductOrigin {
  PURCHASED
  DIY
}

enum ProductSaleRule {
  COST
  PERCENT_30
  PERCENT_50
  PERCENT_100
  PERCENT_200
  FIXED_AMOUNT
  CUSTOM_PERCENT
  CUSTOM_AMOUNT
}

enum DiyUsageUnit {
  STRAND
  BEAD
  GRAM
}

model ProductPurchaseEntry {
  id            String        @id @default(cuid())
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId       String
  batch         MaterialBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  distributorId String
  distributor   Distributor   @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  quantity      Int
  unitCost      Decimal       @db.Decimal(12, 2)
  notes         String        @default("") @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([productId, createdAt])
  @@index([batchId])
  @@index([distributorId])
}

model ProductDiyRun {
  imageImport          DiyImageImport?
  cards                ProductCard[]
  id                   String                  @id @default(cuid())
  productId            String
  product              Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity             Int
  perUnitCost          Decimal                 @db.Decimal(12, 2)
  totalCost            Decimal?                @db.Decimal(22, 2)
  perUnitQuote         Decimal?                @db.Decimal(22, 2)
  totalQuote           Decimal?                @db.Decimal(22, 2)
  craftDesignFee       Json                    @default("{\"unitAmount\":\"0\",\"accumulateByQuantity\":false,\"totalAmount\":null}")
  legacySilver         Boolean                 @default(true)
  silverWeightGrams    Decimal                 @default(0) @db.Decimal(12, 2)
  silverCostGramPrice  Decimal                 @default(20) @db.Decimal(12, 2)
  silverQuoteGramPrice Decimal                 @default(30) @db.Decimal(12, 2)
  extraCosts           Json                    @default("[]")
  notes                String                  @default("") @db.Text
  materialLines        ProductDiyMaterial[]
  pricingLines         ProductDiyPricingLine[]
  cabochonLines        ProductDiyCabochon[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([productId, createdAt])
}

model ProductCard {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  runId           String?
  run             ProductDiyRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  title           String
  templateId      String
  templateVersion Int            @default(1)
  data            Json
  quoteSnapshot   Json?
  sourceSnapshot  Json
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([productId, updatedAt])
  @@index([runId])
}

model ProductCardAsset {
  id         String   @id @default(uuid())
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind       String
  storageKey String   @unique
  sourceKey  String?
  createdAt  DateTime @default(now())

  @@index([productId, sourceKey])
}

model ProductCardBrandSettings {
  id        String   @id @default("default")
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model SilverPricing {
  id             String   @id @default("default")
  costGramPrice  Decimal  @default(20) @db.Decimal(12, 2)
  quoteGramPrice Decimal  @default(30) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt
}

model MaterialPricingGroup {
  id                String                       @id @default(cuid())
  name              String                       @unique
  lossRate          Decimal                      @default(0) @db.Decimal(5, 2)
  marketLinked      Boolean                      @default(true)
  marketCoefficient Decimal                      @default(1) @db.Decimal(8, 4)
  pricingRule       String                       @default("CUSTOM")
  pricingValue      Decimal?                     @db.Decimal(12, 2)
  enabled           Boolean                      @default(false)
  version           Int                          @default(1)
  materials         Material[]
  publications      MaterialPricingPublication[]
  diyLines          ProductDiyPricingLine[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
}

model MaterialPricingPublication {
  id            String                  @id @default(cuid())
  groupId       String
  group         MaterialPricingGroup    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  version       Int
  saleGramPrice Decimal                 @db.Decimal(12, 2)
  costBasis     Json
  fingerprint   String
  createdAt     DateTime                @default(now())
  diyLines      ProductDiyPricingLine[]

  @@unique([groupId, version])
  @@index([groupId, createdAt])
}

model ProductDiyPricingLine {
  id             String                     @id @default(cuid())
  runId          String
  run            ProductDiyRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  groupId        String
  group          MaterialPricingGroup       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  publicationId  String
  publication    MaterialPricingPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  name           String
  quantity       Decimal                    @db.Decimal(12, 2)
  unitCost       Decimal                    @db.Decimal(12, 2)
  lineCost       Decimal                    @db.Decimal(12, 2)
  quoteUnitPrice Decimal                    @db.Decimal(12, 2)
  quoteLineTotal Decimal                    @db.Decimal(22, 2)
  costSnapshot   Json
  costBasisToken String                     @db.Text
  position       Int

  @@unique([runId, position])
  @@index([groupId])
  @@index([publicationId])
}

model DiyCommonFeeSettings {
  id        String   @id @default("default")
  fees      Json
  updatedAt DateTime @updatedAt
}

model ProductDiyMaterial {
  id                   String             @id @default(cuid())
  runId                String
  run                  ProductDiyRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  materialBatchEntryId String
  materialBatchEntry   MaterialBatchEntry @relation(fields: [materialBatchEntryId], references: [id], onDelete: Restrict)
  usageUnit            DiyUsageUnit
  quantity             Decimal            @db.Decimal(12, 2)
  unitCost             Decimal            @db.Decimal(12, 2)
  lineCost             Decimal            @db.Decimal(12, 2)
  quoteUnitPrice       Decimal?           @db.Decimal(12, 2)
  quoteLineTotal       Decimal?           @db.Decimal(22, 2)
  quoteSnapshot        Json?
  position             Int

  @@unique([runId, position])
  @@index([materialBatchEntryId])
}

model ProductDiyCabochon {
  id             String        @id @default(cuid())
  runId          String
  run            ProductDiyRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation("DiyCabochonInput", fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  unitCost       Decimal       @db.Decimal(12, 2)
  lineCost       Decimal       @db.Decimal(12, 2)
  quoteUnitPrice Decimal?      @db.Decimal(12, 2)
  quoteLineTotal Decimal?      @db.Decimal(22, 2)
  quoteSnapshot  Json?
  position       Int

  @@unique([runId, position])
  @@index([productId])
}

model ProductStockAdjustment {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  delta     Int
  beforeQty Int?
  afterQty  Int?
  reason    String   @db.Text
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model ProductMarketing {
  productId                 String  @id
  product                   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  videoShot                 Boolean @default(false)
  xiaohongshuVideoPublished Boolean @default(false)
  xiaohongshuListed         Boolean @default(false)
  douyinVideoPublished      Boolean @default(false)
  douyinListed              Boolean @default(false)
}

model CabochonMeasurement {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lengthMm  Decimal? @db.Decimal(10, 2)
  widthMm   Decimal? @db.Decimal(10, 2)
  heightMm  Decimal? @db.Decimal(10, 2)
}

model CabochonCost {
  productId      String   @id
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  roughStoneCost Decimal? @db.Decimal(12, 2)
  settingCost    Decimal? @db.Decimal(12, 2)
  otherCosts     Json     @default("[]")
  totalCost      Decimal  @db.Decimal(12, 2)
  totalManual    Boolean  @default(false)
}

model SettingStyle {
  id            String              @id @default(cuid())
  magicBoxStyle String              @unique
  cabochons     CabochonExtraInfo[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model CabochonExtraInfo {
  productId      String        @id
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  settingStyleId String?
  settingStyle   SettingStyle? @relation(fields: [settingStyleId], references: [id], onDelete: Restrict)

  @@index([settingStyleId])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([productId, tagId])
  @@index([tagId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  objectKey String
  url       String
  position  Int

  /// Square list cover settings; the original image is preserved.
  framing Json?

  @@unique([productId, position])
}

model UploadGrant {
  id         String    @id @default(cuid())
  objectKey  String    @unique
  url        String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  uploadedAt DateTime?
  usedAt     DateTime?
}

/// Recognition drafts are kept separate from stock until explicitly committed.
model MaterialImageImport {
  id            String                    @id @default(cuid())
  sourceKey     String                    @unique
  sourceUrl     String
  fileName      String
  width         Int
  height        Int
  provider      String
  model         String
  promptVersion String
  status        String                    @default("DRAFT")
  version       Int                       @default(0)
  settings      Json
  warnings      Json
  errorCode     String?
  runToken      String?
  leaseUntil    DateTime?
  archivedAt    DateTime?
  items         MaterialImageImportItem[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([createdAt])
}

model MaterialImageImportItem {
  id         String              @id @default(uuid())
  importId   String
  import     MaterialImageImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  position   Int
  data       Json
  materialId String?
  material   Material?           @relation(fields: [materialId], references: [id], onDelete: SetNull)
  entryId    String?             @unique
  entry      MaterialBatchEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())

  @@unique([importId, position])
  @@index([materialId])
}

enum MaterialUnit {
  STRAND
  BEAD
  GRAM
}

enum MaterialPriceSource {
  COUNT
  WEIGHT
  CUSTOM
}

enum MaterialSaleRule {
  COST
  PERCENT_10
  PERCENT_20
  PERCENT_30
  PERCENT_50
  PERCENT_60
  FIXED_AMOUNT
  CUSTOM_PERCENT
  CUSTOM_AMOUNT
}

model MaterialCategory {
  id        String             @id @default(cuid())
  name      String
  aliases   String[]           @default([])
  parentId  String?
  parent    MaterialCategory?  @relation("MaterialCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  MaterialCategory[] @relation("MaterialCategoryTree")
  materials Material[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([parentId])
}

model Material {
  id                     String                    @id @default(cuid())
  pricingGroupId         String?
  pricingGroup           MaterialPricingGroup?     @relation(fields: [pricingGroupId], references: [id], onDelete: Restrict)
  name                   String
  aliases                String[]                  @default([])
  categoryId             String
  category               MaterialCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit                   MaterialUnit              @default(STRAND)
  purchaseUnitPrice      Decimal?                  @db.Decimal(12, 2)
  weightGrams            Decimal?                  @db.Decimal(12, 2)
  purchaseGramPrice      Decimal?                  @db.Decimal(12, 2)
  purchaseGramManual     Boolean                   @default(false)
  lengthMm               Decimal?                  @db.Decimal(12, 2)
  widthMm                Decimal?                  @db.Decimal(12, 2)
  heightMm               Decimal?                  @db.Decimal(12, 2)
  childCount             Int?
  childWeightGrams       Decimal?                  @db.Decimal(12, 2)
  childUnitPrice         Decimal?                  @db.Decimal(12, 2)
  childPriceSource       MaterialPriceSource?
  lossRate               Decimal?                  @db.Decimal(5, 2)
  baseSaleUnitPrice      Decimal?                  @db.Decimal(12, 2)
  baseSaleGramPrice      Decimal?                  @db.Decimal(12, 2)
  baseSaleChildUnitPrice Decimal?                  @db.Decimal(12, 2)
  saleRule               MaterialSaleRule          @default(COST)
  saleRuleValue          Decimal?                  @db.Decimal(12, 2)
  saleUnitPrice          Decimal?                  @db.Decimal(12, 2)
  saleGramPrice          Decimal?                  @db.Decimal(12, 2)
  saleChildUnitPrice     Decimal?                  @db.Decimal(12, 2)
  saleUnitManual         Boolean                   @default(false)
  saleGramManual         Boolean                   @default(false)
  saleChildManual        Boolean                   @default(false)
  notes                  String                    @default("") @db.Text
  images                 MaterialImage[]
  tags                   MaterialTag[]
  batchEntries           MaterialBatchEntry[]
  imageImportItems       MaterialImageImportItem[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([categoryId])
  @@index([pricingGroupId])
  @@index([createdAt])
}

model MaterialTag {
  materialId String
  tagId      String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([materialId, tagId])
  @@index([tagId])
}

model MaterialBatch {
  id                 String                    @id @default(cuid())
  purpose            String                    @default("GENERAL")
  name               String                    @unique
  receivedAt         DateTime                  @db.Date
  notes              String                    @default("") @db.Text
  entries            MaterialBatchEntry[]
  productEntries     ProductPurchaseEntry[]
  coverObjectKey     String?
  attachmentsVersion Int                       @default(0)
  attachments        MaterialBatchAttachment[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([receivedAt])
}

model MaterialBatchEntry {
  recentDiyUses            DiyRecentMaterial[]
  id                       String                    @id @default(cuid())
  materialId               String
  material                 Material                  @relation(fields: [materialId], references: [id], onDelete: Restrict)
  batchId                  String
  batch                    MaterialBatch             @relation(fields: [batchId], references: [id], onDelete: Restrict)
  distributorId            String
  distributor              Distributor               @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  receivedQty              Decimal?                  @db.Decimal(12, 2)
  remainingQty             Decimal?                  @db.Decimal(12, 2)
  stockAdjustments         MaterialStockAdjustment[]
  purchaseInputMode        String                    @default("UNIT")
  purchaseTotalWeightGrams Decimal?                  @db.Decimal(12, 2)
  purchaseTotalAmount      Decimal?                  @db.Decimal(12, 2)
  purchaseQuotedGramPrice  Decimal?                  @db.Decimal(12, 2)
  purchaseQuotePurpose     String                    @default("LEGACY")
  purchaseAutoField        String?
  sampleWeightGrams        Decimal?                  @db.Decimal(12, 2)
  manualPurchaseUnitPrice  Decimal?                  @db.Decimal(12, 2)
  purchaseUnitInputs       Json?
  unitPriceSource          String                    @default("UNIT")
  purchaseUnitPrice        Decimal?                  @db.Decimal(12, 2)
  weightGrams              Decimal?                  @db.Decimal(12, 2)
  purchaseGramPrice        Decimal?                  @db.Decimal(12, 2)
  purchaseGramManual       Boolean                   @default(false)
  lengthMm                 Decimal?                  @db.Decimal(12, 2)
  widthMm                  Decimal?                  @db.Decimal(12, 2)
  heightMm                 Decimal?                  @db.Decimal(12, 2)
  childCount               Int?
  childWeightGrams         Decimal?                  @db.Decimal(12, 2)
  childUnitPrice           Decimal?                  @db.Decimal(12, 2)
  childPriceSource         MaterialPriceSource?
  lossRate                 Decimal?                  @db.Decimal(5, 2)
  baseSaleUnitPrice        Decimal?                  @db.Decimal(12, 2)
  baseSaleGramPrice        Decimal?                  @db.Decimal(12, 2)
  baseSaleChildUnitPrice   Decimal?                  @db.Decimal(12, 2)
  saleRule                 MaterialSaleRule          @default(COST)
  saleRuleValue            Decimal?                  @db.Decimal(12, 2)
  saleUnitPrice            Decimal?                  @db.Decimal(12, 2)
  saleGramPrice            Decimal?                  @db.Decimal(12, 2)
  saleChildUnitPrice       Decimal?                  @db.Decimal(12, 2)
  saleUnitManual           Boolean                   @default(false)
  saleGramManual           Boolean                   @default(false)
  saleChildManual          Boolean                   @default(false)
  images                   MaterialBatchImage[]
  diyLines                 ProductDiyMaterial[]
  imageImportItem          MaterialImageImportItem?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([materialId, batchId])
  @@index([materialId, createdAt])
  @@index([batchId])
  @@index([distributorId])
}

model MaterialStockAdjustment {
  id        String             @id @default(cuid())
  entryId   String
  entry     MaterialBatchEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  beforeQty Decimal?           @db.Decimal(12, 2)
  afterQty  Decimal            @db.Decimal(12, 2)
  delta     Decimal?           @db.Decimal(12, 2)
  reason    String             @db.Text
  createdAt DateTime           @default(now())

  @@index([entryId, createdAt])
}

model MaterialBatchAttachment {
  assetId   String
  asset     SharedAttachment @relation(fields: [assetId], references: [id], onDelete: Cascade)
  id        String           @id @default(cuid())
  batchId   String
  batch     MaterialBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  objectKey String
  url       String
  fileName  String
  notes     String           @default("") @db.Text
  position  Int
  createdAt DateTime         @default(now())

  @@unique([batchId, assetId])
  @@unique([batchId, position])
  @@unique([batchId, objectKey])
}

model MaterialBatchImage {
  id        String             @id @default(cuid())
  entryId   String
  entry     MaterialBatchEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  objectKey String
  url       String
  position  Int

  /// Square list cover settings; the original image is preserved.
  framing Json?

  @@unique([entryId, position])
}

model MaterialImage {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  objectKey  String
  url        String
  position   Int

  /// Square list cover settings; the original image is preserved.
  framing Json?

  @@unique([materialId, position])
}

/// Multi-view DIY recognition stays outside product stock until reviewed and committed.
model DiyImageImport {
  id            String         @id @default(uuid())
  images        Json
  data          Json
  status        String         @default("DRAFT")
  version       Int            @default(0)
  provider      String         @default("")
  model         String         @default("")
  promptVersion String         @default("")
  warnings      Json           @default("[]")
  errorCode     String?
  runToken      String?
  leaseUntil    DateTime?
  productId     String?
  product       Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  runId         String?        @unique
  run           ProductDiyRun? @relation(fields: [runId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([createdAt])
  @@index([productId])
}

/// Durable business identity. No cascading FK: history survives object/account deletion.
model RecordAttribution {
  entityType  String
  entityId    String
  entityLabel String
  rootType    String
  rootId      String
  createdBy   Json?
  updatedBy   Json?
  createdAt   DateTime
  updatedAt   DateTime
  deletedAt   DateTime?

  @@id([entityType, entityId])
  @@index([rootType, rootId])
}

model AuditLog {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  operationId   String
  source        String
  actorId       String?
  actorUsername String?
  actorNickname String?
  action        String
  entityType    String
  entityId      String
  entityLabel   String
  rootType      String
  rootId        String
  relatedIds    String[]
  before        Json?
  after         Json?
  changedFields String[]
  createdAt     DateTime @default(now())

  @@index([createdAt(sort: Desc), id])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([rootType, rootId, createdAt(sort: Desc)])
  @@index([operationId])
  @@index([relatedIds], type: Gin)
}

// Assistant-only persistence. Business records are never written by this subsystem.
model AssistantConversation {
  id                String               @id @default(uuid())
  ownerId           String
  title             String?              @db.VarChar(80)
  revision          Int                  @default(0)
  state             Json?
  activeExecutionId String?
  leaseUntil        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  executions        AssistantExecution[]
  messages          AssistantMessage[]
  feedback          AssistantFeedback[]

  @@index([ownerId, updatedAt(sort: Desc)])
}

model AssistantExecution {
  id             String                @id @default(uuid())
  conversationId String
  ownerId        String
  generation     Int
  parentId       String?
  text           String
  data           Json
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  feedback AssistantFeedback[]

  @@unique([conversationId, generation])
  @@index([ownerId, conversationId, createdAt])
}

model AssistantMessage {
  id             String                @id @default(uuid())
  conversationId String
  ownerId        String
  executionId    String
  role           String
  content        Json
  createdAt      DateTime              @default(now())
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback       AssistantFeedback[]

  @@unique([executionId, role])
  @@index([ownerId, conversationId, createdAt])
}

// Feedback is a review queue, never an automatic rule update.
model AssistantFeedback {
  id                     String                @id @default(uuid())
  ownerId                String
  conversationId         String
  executionId            String
  questionMessageId      String
  kind                   String
  target                 Json?
  note                   String                @default("") @db.Text
  ruleVersion            String
  promptVersion          String
  relevancePromptVersion String
  status                 String                @default("pending_review")
  createdAt              DateTime              @default(now())
  conversation           AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  execution              AssistantExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  question               AssistantMessage      @relation(fields: [questionMessageId], references: [id], onDelete: Cascade)

  @@index([ownerId, conversationId, createdAt(sort: Desc)])
  @@index([executionId])
}

/// Personal selection history, updated only in a successful DIY save transaction.
model DiyRecentMaterial {
  ownerId String
  owner   Admin              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entryId String
  entry   MaterialBatchEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  usedAt  DateTime           @default(now())

  @@id([ownerId, entryId])
  @@index([ownerId, usedAt(sort: Desc)])
}

model DiyRecentCabochon {
  ownerId   String
  owner     Admin    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  usedAt    DateTime @default(now())

  @@id([ownerId, productId])
  @@index([ownerId, usedAt(sort: Desc)])
}

// Owner tables retain display projections for existing list queries. Only the shared
// attachment service writes these fields; image and notes are authoritative here.
model SharedAttachment {
  id           String                    @id @default(cuid())
  objectKey    String
  url          String
  fileName     String
  notes        String                    @default("") @db.Text
  version      Int                       @default(1)
  imageVersion Int                       @default(1)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @default(now()) @updatedAt
  distributors DistributorAttachment[]
  batches      MaterialBatchAttachment[]
  recognitions AttachmentRecognition[]

  @@index([objectKey])
}

model AttachmentRecognition {
  id            String           @id
  assetId       String
  asset         SharedAttachment @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ownerId       String
  imageVersion  Int
  promptVersion String
  provider      String
  model         String
  status        String
  result        Json?
  usage         Json?
  errorCode     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  @@index([assetId, imageVersion, createdAt])
}
