DATABASE_URL="postgresql://crystal:crystal@localhost:5432/crystal_mate?schema=public"
DIRECT_URL="postgresql://crystal:crystal@localhost:5432/crystal_mate?schema=public"
E2E_DATABASE_URL="postgresql://crystal:crystal@localhost:5432/crystal_mate_test?schema=public"
E2E_USERNAME="test-admin"
E2E_PASSWORD="replace-with-test-password"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="123456"
MEDIA_STORAGE="local"
# Private image disk cache; defaults to .cache/images. Oldest files are evicted at this limit.
MEDIA_CACHE_MAX_MB="512"
# MEDIA_CACHE_DIR="/absolute/path/to/image-cache"
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""

# Optional overrides for the approved zhuyu.life public security filing.
# Empty values use the built-in record 44011202004514, official query URL, and local icon.
PUBLIC_SECURITY_RECORD_NUMBER=""
PUBLIC_SECURITY_RECORD_URL=""
PUBLIC_SECURITY_RECORD_ICON=""

# Image imports: DeepSeek's image-capable model (https://api-docs.deepseek.com/guides/vision)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_VISION_MODEL="deepseek-flash"

# Optional second image model using Chat Completions + image_url + JSON output.
# Use an HTTPS base URL ending in /v1 if the provider requires that prefix.
IMPORT_VISION_LABEL=""
IMPORT_VISION_BASE_URL=""
IMPORT_VISION_API_KEY=""
IMPORT_VISION_MODEL=""

# Name/type tag recognition reuses DeepSeek above by default.
# Optional text model overrides (Chat Completions + JSON output).
TAG_RECOGNITION_BASE_URL=""
TAG_RECOGNITION_API_KEY=""
TAG_RECOGNITION_MODEL=""

# DIY product card copywriting (text only). Empty credentials/base URL reuse DeepSeek.
PRODUCT_CARD_API_KEY=""
PRODUCT_CARD_BASE_URL=""
PRODUCT_CARD_MODEL="deepseek-flash"

# Assistant text model: independent from DEEPSEEK_VISION_MODEL.
# Empty credentials/base URL reuse DEEPSEEK_API_KEY/BASE_URL; model defaults to deepseek-flash.
# A different provider may require all three overrides. Keep these server-side.
ASSISTANT_API_KEY=""
ASSISTANT_BASE_URL=""
ASSISTANT_MODEL="deepseek-flash"

# Optional relevance-only overrides; otherwise use ASSISTANT_* above.
ASSISTANT_RELEVANCE_API_KEY=""
ASSISTANT_RELEVANCE_BASE_URL=""
ASSISTANT_RELEVANCE_MODEL=""
